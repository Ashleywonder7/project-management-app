datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// Enums
// ==========================================

enum Role {
  ADMIN
  PROJECT_MANAGER
  STAFF
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum EventStatus {
  UPCOMING
  DUE
  OVERDUE
  COMPLETED
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  DEADLINE_ALERT
  PASSWORD_RESET
}

// ==========================================
// Core User & Auth Models
// ==========================================

model User {
  id                    String                 @id @default(uuid())
  staffId               String                 @unique
  firstName             String
  lastName              String
  email                 String                 @unique
  isEmailVerified       Boolean                @default(false)
  phoneNumber           String?                @unique
  isPhoneVerified       Boolean                @default(false)
  passwordHash          String
  department            String
  jobTitle              String
  role                  Role                   @default(STAFF)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  // Security & Notification Relations
  tokens                VerificationToken[]
  notificationLogs      NotificationLog[]
  notificationRecipients NotificationConfigRecipient[]

  // Project Relations
  managedProjects       Project[]              @relation("ProjectManager")
  assignedTasks         Task[]                 @relation("TaskAssignee")
  createdTasks          Task[]                 @relation("TaskCreator")

  // Event Relations
  createdEvents         Event[]                @relation("EventCreator")
  assignedEvents        EventStaffAssignment[]

  @@map("users")
}

model VerificationToken {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  tokenHash  String           @unique
  code       String?          // 6-digit numeric OTP for SMS verification
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  @@map("verification_tokens")
  @@index([userId, type, expiresAt])
}

model NotificationConfig {
  id                String              @id @default(uuid())
  channel           NotificationChannel @unique
  enabled           Boolean             @default(true)
  leadNoticeDays    Int[]               @default([1, 3, 7])
  notifyEngagements Boolean              @default(true)
  notifyProposals   Boolean              @default(true)
  notifyMeetings    Boolean              @default(true)
  recipientRoles    String[]             @default(["ASSIGNED_STAFF", "PROJECT_MANAGER"])
  recipients        NotificationConfigRecipient[]
  updatedAt         DateTime             @updatedAt

  @@map("notification_configs")
}

model NotificationConfigRecipient {
  notificationConfigId String
  userId               String
  notificationConfig   NotificationConfig @relation(fields: [notificationConfigId], references: [id], onDelete: Cascade)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationConfigId, userId])
  @@index([userId])
  @@map("notification_config_recipients")
}

model NotificationLog {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     NotificationChannel
  recipient   String
  subject     String?
  body        String
  status      String              // "SENT", "FAILED", "DELIVERED"
  sentAt      DateTime            @default(now())

  @@map("notification_logs")
  @@index([userId, sentAt])
  @@index([channel, status, sentAt])
}

// ==========================================
// Project Management Models
// ==========================================

model Project {
  id          String        @id @default(uuid())
  code        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime
  endDate     DateTime?
  
  managerId   String
  manager     User          @relation("ProjectManager", fields: [managerId], references: [id])
  
  tasks       Task[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("projects")
}

model Task {
  id          String     @id @default(uuid())
  taskNumber  Int        @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?

  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])

  createdById String
  createdBy   User       @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("tasks")
}

// ==========================================
// Event & Scheduling Models
// ==========================================

model Event {
  id            String                 @id @default(uuid())
  title         String
  description   String?
  venue         String
  status        EventStatus            @default(UPCOMING)
  completedAt   DateTime?
  
  createdById   String
  createdBy     User                   @relation("EventCreator", fields: [createdById], references: [id])
  
  schedules     EventSchedule[]
  assignedStaff EventStaffAssignment[]

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@map("events")
}

model EventSchedule {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date      DateTime
  startTime String
  endTime   String

  @@map("event_schedules")
}

model EventStaffAssignment {
  id      String @id @default(uuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_staff_assignments")
}